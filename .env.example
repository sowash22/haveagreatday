# Server-only v2 inference API configuration.
BACKEND_API_URL=https://your-inference-api.example/v2/chat/completions
CLIENT_API_KEY=
CLIENT_ID=haveagreatday

# Optional. When omitted, the v2 endpoint chooses from its available providers.
PROVIDER=

# Optional LangGraph ReAct agent. Without this, the app uses the endpoint above,
# then its deterministic local fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
